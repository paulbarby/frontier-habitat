  "pack_applied": {"name": "Applied research packs", "role": "", "category": "industry", "inputs": {"glass": 1, "electronics": 1},          "outputs": {"pack_applied": 1}, "work": 60.0, "water_net": 1, "auto": true, "stock_max": 12},
  "pack_exotic":  {"name": "Exotic research packs",  "role": "", "category": "industry", "inputs": {"exotic": 1, "composite": 1, "electronics": 1}, "outputs": {"pack_exotic": 1}, "work": 90.0, "water_net": 1, "auto": true, "stock_max": 16}
