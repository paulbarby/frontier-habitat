  "refine":     {"name": "Refine steel",     "role": "technician", "category": "industry", "inputs": {"ore": 2},                          "outputs": {"metal": 1},        "work": 20.0},
  "polymerize": {"name": "Make polymer",     "role": "technician", "category": "industry", "inputs": {"biomass": 2},                      "outputs": {"polymer": 1},      "work": 20.0, "stock_max": 80},
  "spares":     {"name": "Make spare parts", "role": "technician", "category": "industry", "inputs": {"metal": 1, "polymer": 1},           "outputs": {"spare_parts": 2},  "work": 30.0, "stock_max": 16},
  "glass":      {"name": "Melt glass",       "role": "technician", "category": "industry", "inputs": {"silicate": 2},                     "outputs": {"glass": 1},        "work": 30.0, "stock_max": 30},
  "electronics":{"name": "Make electronics", "role": "technician", "category": "industry", "inputs": {"silicate": 1, "metal": 1},          "outputs": {"electronics": 1},  "work": 40.0, "stock_max": 40},
  "hull_plate": {"name": "Press hull plates","role": "technician", "category": "industry", "inputs": {"metal": 1, "polymer": 1},           "outputs": {"hull_plate": 1},   "work": 30.0, "stock_max": 30, "stock_for": "ship"},
  "composite":  {"name": "Lay composite",    "role": "technician", "category": "industry", "inputs": {"polymer": 2, "glass": 1},           "outputs": {"composite": 1},    "work": 40.0, "stock_max": 20},
  "medicine":   {"name": "Make medicine",    "role": "medic",      "category": "industry", "inputs": {"herbs": 1, "polymer": 1},           "outputs": {"medicine": 2},     "work": 30.0, "stock_max": 12},
