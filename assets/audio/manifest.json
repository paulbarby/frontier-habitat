    "_note": "Paul 2026-09-26: effect sounds only when zoomed in and close. local: zoom (camera distance to its focus) full <= zoom_full, silent >= zoom_off; source full within near_full of the focus, silent at near_off. big: every zoom; zoomed out (>= zoom_far) at far_gain of the level; full within near_full, silent at near_off. Metres.",
    "local": {
      "zoom_full": 20,
      "zoom_off": 35,
      "near_full": 8,
      "near_off": 25
    },
    "big": {
      "zoom_full": 35,
      "zoom_far": 150,
      "far_gain": 0.4,
