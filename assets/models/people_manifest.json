   "Hair*": "Hair, Hair_brows, Hair_lashes: tint like v3 Hair (mode 3); alpha MASK (clip 0.5); the texture multiplies",
   "SuitAccent": "department colour (mode 1): the uniform shirt; the texture multiplies",
   "Coverall": "plain grey trousers (texture)",
   "ClothTint": "per-person clothes colour; the texture multiplies",
   "Eye": "plain, textured",
   "Teeth": "plain",
   "Cloth_*": "plain, textured (the garment's own look)"
  },
  "vertex_color": "COLOR_0.r = baked ambient occlusion (as v3)",
  "lod": "LOD0 only in this pilot (<= 24k triangles per person on screen).  LOD1 (<= 4k) follows."
